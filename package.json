    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@testing-library/react-native": "^12.0.0",
    "@types/jest": "^29.0.0",
    "jest": "^29.0.0",
    "jest-expo": "~54.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/react-native/extend-expect"
    ],
    "testMatch": [
      "**/__tests__/**/*.{js,ts,tsx}",
      "**/*.test.{js,ts,tsx}"
    ]
