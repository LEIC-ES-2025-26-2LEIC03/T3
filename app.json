      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/splash.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/splash.png"
      },
      "package": "com.anonymous.W8",
      "backgroundColor": "#0A0A0A"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "963b5f14-28a6-4815-8a1b-b293ed883964"
      }
    }
  }
}
